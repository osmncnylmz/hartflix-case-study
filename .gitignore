# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*~
*.log

# JetBrains / Android Studio
.idea/
*.iml
*.iws
*.ipr

# VS Code (keep shared settings if a team ever adds them, drop personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ---------------------------------------------------------------------------
# Dart / Flutter
# ---------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/
**/generated_plugin_registrant.dart

# NOTE: pubspec.lock IS committed. This is an application, not a library, so
# the lockfile is what makes CI and local builds reproducible.

# Coverage output
coverage/
lcov.info

# Symbol files from `flutter build --split-debug-info`
app.*.symbols

